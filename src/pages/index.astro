---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const latest = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en', { day: '2-digit', month: 'short', year: 'numeric' });
---
<Base>
  <main id="main">
    <section class="hero">
      <div class="aurora" aria-hidden="true"></div>

      <p class="eyebrow">User group for early risers</p>

      <h1 class="clock" aria-label="Five a.m.">
        <span class="digit">0</span><span class="digit">5</span><span class="colon" aria-hidden="true">:</span><span class="digit">0</span><span class="digit">0</span>
      </h1>

      <p class="lede">Wake up <em>before</em> the world does.</p>
      <p class="sub">Tomorrow's edge is built before sunrise. <span class="accent-text">No app. No fee. Just discipline.</span></p>

      <div class="cta-row">
        <a class="btn primary" href="#why">Why 5 a.m.</a>
        <a class="btn ghost" href="/posts">Read the writing</a>
      </div>
    </section>

    <section class="manifesto" id="manifesto">
      <p class="kicker"><span class="dot" aria-hidden="true"></span> Manifesto</p>
      <blockquote class="quote">
        <p>"We don't wake up at 5 a.m. because we have a lot of work to do, or to brag about how hard-working we are. It's about giving your maximum for your business to be successful — and if that means waking up at an unusual hour for most, you'll likely start liking the sunrise."</p>
        <footer>— <a href="https://www.cnbc.com/2017/04/11/richard-branson-wakes-up-at-5-a-m-each-morning-heres-his-routine.html" target="_blank" rel="noopener">Richard Branson</a></footer>
      </blockquote>
    </section>

    <section class="why" id="why">
      <header class="section-head">
        <p class="kicker"><span class="dot" aria-hidden="true"></span> Why 5 a.m.</p>
        <h2>Seven reasons to claim the morning.</h2>
      </header>

      <ol class="reasons">
        <li class="reason reason--wide">
          <span class="num" aria-hidden="true">01</span>
          <h3>Head start</h3>
          <p>When 99% of people are still sleeping you begin the day with an edge. Willpower peaks. Laziness ceases to exist.</p>
        </li>
        <li class="reason">
          <span class="num" aria-hidden="true">02</span>
          <h3>Start prepared</h3>
          <p>If you don't have a morning ritual, build one — fast. Treat every day of your life as a unique event. Start ready.</p>
        </li>
        <li class="reason">
          <span class="num" aria-hidden="true">03</span>
          <h3>Higher productivity</h3>
          <p>No rush, planning done — you can afford to start with the <strong>most important tasks</strong>, not the urgent ones.</p>
        </li>
        <li class="reason">
          <span class="num" aria-hidden="true">04</span>
          <h3>Silence as a resource</h3>
          <p>The morning is the perfect environment for focused work. Not just the silence around you — the silence inside.</p>
        </li>
        <li class="reason">
          <span class="num" aria-hidden="true">05</span>
          <h3>Happier mind</h3>
          <p>How you start your day shapes the rest of it. A <a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3181883/" target="_blank" rel="noopener nofollow">study published at NCBI</a> showed nocturnal people are 3× more prone to depression than morning people.</p>
        </li>
        <li class="reason">
          <span class="num" aria-hidden="true">06</span>
          <h3>Healthier body</h3>
          <p>Sleep early, wake early, and your body syncs with the circadian cycle — the 24h biological rhythm of living beings.</p>
        </li>
        <li class="reason reason--wide">
          <span class="num" aria-hidden="true">07</span>
          <h3>Mastery</h3>
          <p>Self-control, refinement, discipline. You start acting like a professional, not an amateur. The art of living every day at its maximum.</p>
        </li>
      </ol>
    </section>

    <section class="video-section" id="watch">
      <header class="section-head">
        <p class="kicker"><span class="dot" aria-hidden="true"></span> Watch</p>
        <h2>5 tips on how to wake up early.</h2>
        <p class="section-sub">Robin Sharma shares the essential keys to make early mornings stick.</p>
      </header>

      <a class="video-card" href="https://www.youtube.com/watch?v=z6hsOLVwfFc" target="_blank" rel="noopener" aria-label="Watch on YouTube">
        <img src="/img/video.png" alt="" loading="lazy" />
        <span class="play" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="video-meta">Watch on YouTube</span>
      </a>
    </section>

    {latest.length > 0 && (
      <section class="latest">
        <header class="section-head">
          <p class="kicker"><span class="dot" aria-hidden="true"></span> Writing</p>
          <h2>Recent posts.</h2>
        </header>

        <ol class="post-list">
          {latest.map((post) => (
            <li>
              <a href={`/posts/${post.id}`}>
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFmt.format(post.data.pubDate)}
                </time>
                <div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="join" id="join">
      <header class="section-head">
        <p class="kicker"><span class="dot" aria-hidden="true"></span> How to join</p>
        <h2>You don't need permission. Just start.</h2>
        <p class="section-sub">Change yourself first — then change the others.</p>
      </header>

      <div class="join-cta">
        <a class="btn primary" href="https://twitter.com/intent/tweet?text=I%27m%20joining%20%23the5amclub%20%E2%98%80%EF%B8%8F&url=https%3A%2F%2Fthe5am.club" target="_blank" rel="noopener">
          Commit publicly
        </a>
        <a class="btn ghost" href="https://github.com/avelino/the5am.club/issues" target="_blank" rel="noopener">
          Contribute on GitHub
        </a>
      </div>
    </section>
  </main>
</Base>
